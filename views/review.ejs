<%- include('header') %>
<div class="panel">
  <h1>Review allocation</h1>
  <p>Availability is checked again when you confirm.</p>
  <table>
    <tbody>
      <tr><th>Patient</th><td><%= a.first_name %> <%= a.last_name %></td></tr>
      <tr><th>Priority</th><td><span class="badge <%= a.priority %>"><%= a.priority %></span></td></tr>
      <tr><th>Department</th><td><%= a.department %></td></tr>
      <tr><th>Doctor</th><td><%= a.doctor_name %></td></tr>
      <tr><th>Bed</th><td><%= a.bed_number %> (<%= a.ward_type %> ward)</td></tr>
      <tr><th>Equipment</th><td><%= a.equipment_name || 'None' %></td></tr>
    </tbody>
  </table>
  <div class="actions">
    <form class="inline" method="post" action="/allocations/<%= a.id %>/confirm"><button class="btn" type="submit">Confirm allocation</button></form>
    <form class="inline" method="post" action="/allocations/<%= a.id %>/cancel"><button class="btn secondary" type="submit">Cancel</button></form>
  </div>
</div>
<%- include('footer') %>
